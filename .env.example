# Client (Vite) — only these two are embedded in the browser bundle.
# They are safe to expose: the database is protected by Row-Level Security.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-side only — NEVER prefix these with VITE_ (Vite would embed them
# in the client bundle and leak them). Used locally for migrations/admin scripts.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Edge functions (set via `supabase secrets set` or the dashboard)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected in production.
# RESEND_API_KEY=your_resend_key
# PUBLIC_SITE_URL=https://nuhani.com
